<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Event Registration Form</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>Event Registration</h1>
    <p>Fill the form to participate</p>
</header>

<div class="container">

    <!-- Event Banner Image -->
    <img src="event-banner.jpg" alt="Event Banner" class="banner">

    <!-- Registration Form -->
    <form>
        <h2>Participant Details</h2>

        <label for="name">Full Name</label>
        <input type="text" id="name" placeholder="Enter your full name" required>

        <label for="email">Email Address</label>
        <input type="email" id="email" placeholder="Enter your email" required>

        <label for="phone">Mobile Number</label>
        <input type="tel" id="phone" placeholder="Enter mobile number" required>

        <label for="college">College / Organization</label>
        <input type="text" id="college" placeholder="Enter college name">

        <label for="event">Select Event</label>
        <select id="event" required>
            <option value="">-- Choose Event --</option>
            <option>Workshop</option>
            <option>Seminar</option>
            <option>Hackathon</option>
            <option>Cultural Fest</option>
        </select>

        <label for="mode">Participation Mode</label>
        <select id="mode">
            <option>Offline</option>
            <option>Online</option>
        </select>

        <label for="message">Additional Message</label>
        <textarea id="message" rows="4" placeholder="Any notes..."></textarea>

        <label>
            <input type="checkbox" required> I agree to the terms & conditions
        </label>

        <button type="submit">Submit Registration</button>
    </form>

    <!-- Media Section -->
    <div class="media">
        <audio controls>
            <source src="Promo Audio.mp3" type="audio/mpeg">
            Your browser does not support audio.
        </audio>

        <video controls>
            <source src="Promo Video.mp4" type="video/mp4">
            Your browser does not support video.
        </video>
    </div>

</div>

<footer>
    <p>© 2025 Event Management Team</p>
</footer>

</body>
</html>


style.css


/* ===== RESET ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* ===== BODY & TYPOGRAPHY (TC03) ===== */
body {
    font-family: "Segoe UI", Tahoma, sans-serif;
    background: linear-gradient(120deg, #e0e7ff, #fdf2f8);
    color: #1f2937;
}

/* ===== HEADER (TC02) ===== */
header {
    background: linear-gradient(90deg, #6366f1, #ec4899);
    color: white;
    padding: 30px;
    text-align: center;
    letter-spacing: 1px;
}

header h1 {
    font-size: 32px;
    margin-bottom: 5px;
}

/* ===== MAIN CONTAINER (TC04) ===== */
.container {
    max-width: 900px;
    margin: 30px auto;
    background: white;
    padding: 25px;
    border-radius: 14px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

/* ===== IMAGE ===== */
.banner {
    width: 100%;
    border-radius: 12px;
    margin-bottom: 25px;
    transition: transform 0.4s;
}

.banner:hover {
    transform: scale(1.02);
}

/* ===== FLEXBOX MEDIA (TC05) ===== */
.media {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
}

audio, video {
    width: 100%;
    border-radius: 10px;
    background: #f9fafb;
}

/* ===== FORM STYLING ===== */
form h2 {
    text-align: center;
    margin-bottom: 20px;
    color: #4f46e5;
}

label {
    font-weight: 600;
    display: block;
    margin-bottom: 5px;
}

input, select {
    width: 100%;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #c7d2fe;
    margin-bottom: 18px;
    transition: all 0.3s;
}

/* ===== INPUT FOCUS (TC07) ===== */
input:focus, select:focus {
    outline: none;
    border-color: #6366f1;
    box-shadow: 0 0 8px rgba(99,102,241,0.6);
}

/* ===== BUTTON HOVER (TC06) ===== */
button {
    width: 100%;
    padding: 12px;
    border-radius: 25px;
    background: linear-gradient(90deg, #6366f1, #ec4899);
    color: white;
    font-size: 17px;
    border: none;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
}

button:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}

/* ===== FOOTER ===== */
footer {
    margin-top: 40px;
    background: #312e81;
    color: white;
    text-align: center;
    padding: 15px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
}

/* ===== TABLET VIEW (TC08) ===== */
@media (max-width: 768px) {
    .media {
        flex-direction: column;
    }

    header h1 {
        font-size: 26px;
    }
}

/* ===== MOBILE VIEW (TC09) ===== */
@media (max-width: 480px) {
    .container {
        margin: 15px;
        padding: 18px;
    }

    button {
        font-size: 15px;
    }
}
