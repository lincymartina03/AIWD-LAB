style.css

body {
    font-family: Arial;
    margin: 0;
    text-align: center;
    background-color: #f4f4f4;
}

header {
    background: #333;
    color: white;
    padding: 15px;
}

nav a {
    margin: 10px;
    color: white;
    text-decoration: none;
}

nav a:hover {
    color: yellow;
}

section {
    padding: 20px;
}

button {
    padding: 10px 20px;
    background: #333;
    color: white;
    border: none;
    cursor: pointer;
}

button:hover {
    background: #555;
}

footer {
    background: #222;
    color: white;
    padding: 10px;
    position: fixed;
    width: 100%;
    bottom: 0;
}

script.js

function showMsg() {
