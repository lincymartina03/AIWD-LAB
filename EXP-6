<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Event Explorer</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        .event { border: 2px solid #ccc; padding: 15px; margin: 10px; border-radius: 8px; transition: 0.3s; }
        .details { display: none; margin-top: 10px; padding: 10px; background: #f9f9f9; }
        .highlight { color: #6366f1; font-weight: bold; text-transform: uppercase; }
    </style>
</head>
<body>

    <div class="event">
        <h3>Tech Workshop 2026</h3>
        <p>Date: May 15, 2026</p>
        <div class="details">
            <p>Learn the latest in AI and Web Dev.</p>
            <button class="reg-btn">Register</button>
        </div>
        <button class="toggle-btn">Show Details</button>
    </div>

    <div class="event">
        <h3>Design Seminar</h3>
        <p>Date: June 10, 2026</p>
        <div class="details">
            <p>UI/UX principles for modern apps.</p>
            <button class="reg-btn">Register</button>
        </div>
        <button class="toggle-btn">Show Details</button>
    </div>

    <script>
    $(document).ready(function() {
        // Toggle Details Logic
        $(".toggle-btn").click(function() {
            const container = $(this).closest(".event");
            const detailDiv = container.find(".details");
            const title = container.find("h3");

            // 1. Slide Toggle Effect
            detailDiv.slideToggle();

            // 2. Change Button Text
            $(this).text($(this).text() === "Show Details" ? "Hide Details" : "Show Details");

            // 3. Change Background Color using css()
            container.css("background-color", "#e0e7ff");

            // 4. Traversing & Highlighting
            title.addClass("highlight");

            // 5. Retrieve Title and Alert
            const eventTitle = title.text();
            alert("Viewing details for: " + eventTitle);
        });

        // 6. Registration Redirect with Data Passing
        $(".reg-btn").click(function() {
            const eventName = $(this).closest(".event").find("h3").text();
            // Encode URI to handle spaces in titles
            window.location.href = "registration.html?event=" + encodeURIComponent(eventName);
        });
    });
    </script>
</body>
</html>


